# spark-2: DGX Spark, Linux/CUDA. The nemotron3.5-lightning-30b-a3b-cuda-v1 ranked runner of Layr-Labs. Values only.
# tools/box/converge.sh reads this file. Another tenant's runner on this box (BOX_UNTOUCHED_UNITS) is never changed.
BOX_HOST="spark-faf4"
BOX_TRACK_ID="nemotron3.5-lightning-30b-a3b-cuda-v1"
BOX_TRACK_FIXTURE="fixtures/nemotron35_lightning_30b_a3b_track.json"
BOX_GOLDEN_ENV="MLXFAST_NEMOTRON35_GOLDEN_DIR"

BOX_RUNNER_USER="layrbench"
BOX_RUNNER_HOME="/home/layrbench"
BOX_RUNNER_GROUPS="docker bench"
BOX_RUST_TOOLCHAIN="1.98.1"

BOX_STAGING_ROOT="/home/layrbench/nemotron35"
BOX_MIRROR_DIR="/home/layrbench/nemotron35/mirror.git"
BOX_MIRROR_URL="https://github.com/Layr-Labs/cudafast-nemotron35-lightning-30b-a3b-engine-dev.git"
BOX_ENGINE_DIR="/home/layrbench/nemotron35/engine"

# benchd main ff98ea4 (Layr-Labs/mlxfast-bench-dev PR #398, dev channel dist 673cdfc), aarch64-unknown-linux-gnu.
BOX_BENCHD_BIN_DIR="/home/layrbench/nemotron35/benchd-bin"
BOX_BENCHD_SHA256="0a6b84aa84180b7974aeac7a81775e07f823f0261819a188d515dd2ce57ef0a1"
BOX_BENCHD_BYTES="3741704"

# The target snapshot is this track's own copy, root-owned and read-only. The sandbox user reads it in the engine container.
BOX_SNAPSHOT_DIR="/srv/layrbench/nemotron35/snapshot"
BOX_GOLDEN_DIR="/home/layrbench/nemotron35/goldens"
# The reference tree at the fixture's baseline_reference_commit, staged by tools/stage-baseline-workspace.sh.
BOX_BASELINE_WORKSPACE="/home/layrbench/nemotron35/baseline/workspace"
# The build outputs a built reference tree carries (tools/engine/build.sh).
BOX_REFERENCE_BUILT=".build/release/mlxfast-runtime-worker .build/vllm-overlay/vllm/__init__.py"
BOX_BASELINE_CALIBRATION="/home/layrbench/nemotron35/baseline/baseline-calibration.json"

BOX_ACTIONS_RUNNER_DIR="/home/layrbench/actions-runner"
BOX_RUNNER_REPO_URL="https://github.com/Layr-Labs/cudafast-nemotron35-lightning-30b-a3b-engine-dev"
BOX_RUNNER_NAME="spark-2"
BOX_RUNNER_LABELS="nemotron3.5-lightning-30b-a3b-cuda-v1"

BOX_GPU_LOCK="/tmp/mtplx-gpu-exclusive.lock"
BOX_LOCK_GROUP="bench"

BOX_SANDBOX_USER="layrsub"
BOX_SHARE_GROUP="layrshare"
BOX_SANDBOX_ROOT="/var/lib/layrbench/sandbox"
BOX_SANDBOX_ETC="/etc/layrbench-sandbox"
BOX_SUDOERS_NAME="layrbench-sandbox"
BOX_EGRESS_UNIT="layrbench-sandbox-egress.service"
BOX_ACL_UNIT="layrbench-sandbox-acl.service"
BOX_RUST_DIR="/opt/layrbench-rust"
BOX_SERVE_UP_LOG_DIR="/var/lib/layrbench/serve-log"
BOX_SERVE_UP_SOCKET_DIR="/var/lib/layrbench/sock"
BOX_SERVE_UP_CONTAINER_PREFIX="layr-serve-up-"

BOX_UNTOUCHED_UNITS="nemotron35-box-runner.service nemotron35-sandbox-egress.service nemotron35-sandbox-acl.service"
